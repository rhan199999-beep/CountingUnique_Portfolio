{
  "metadata": {
    "name": "Counting Unique Portfolio",
    "version": "2.0.0",
    "created": "2026-10-12",
    "description": "Design token system for portfolio website - 3 layer architecture",
    "skill": "design-system",
    "stack": "nextjs-tailwind"
  },
  "primitives": {
    "color-ink": "#0f0f0f",
    "color-paper": "#ffffff",
    "color-mint": "#c6f5d5",
    "color-accent": "#ff6b9d",
    "color-sky": "#62c3ff",
    "color-muted": "#6b7280",
    "color-gray-50": "#f9fafb",
    "color-gray-100": "#f3f4f6",
    "color-gray-800": "#1f2937",
    "color-gray-200": "#e5e7eb",
    "font-display": "\"Bricolage Grotesque\", \"ui-sans-serif\", system-ui, sans-serif",
    "font-body": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
    "font-mono": "\"SF Mono\", \"Fira Code\", \"Droid Sans Mono\", monospace",
    "spacing-0": "0",
    "spacing-1": "0.25rem",
    "spacing-2": "0.5rem",
    "spacing-3": "0.75rem",
    "spacing-4": "1rem",
    "spacing-5": "1.25rem",
    "spacing-6": "1.5rem",
    "spacing-8": "2rem",
    "spacing-10": "2.5rem",
    "spacing-12": "3rem",
    "border-width": "1px",
    "border-color": "#0f0f0f20",
    "shadow-sm": "0 1px 2px 0 #0f0f0f10",
    "shadow-md": "0 4px 6px -1px #0f0f0f10, 0 2px 4px -1px #0f0f0f5",
    "shadow-lg": "0 10px 15px -3px #0f0f0f10, 0 4px 6px -2px #0f0f0f5"
  },
  "semantic": {
    "color-background": "var(--color-mint)",
    "color-text-primary": "var(--color-ink)",
    "color-text-secondary": "var(--color-muted)",
    "color-border-subtle": "var(--color-ink)/10",
    "color-primary": "var(--color-accent)",
    "color-primary-hover": "color-mix(in srgb, var(--color-accent), black 10%)",
    "color-primary-active": "color-mix(in srgb, var(--color-accent), black 20%)",
    "color-card": "var(--color-mint)",
    "color-card-border": "var(--color-ink)/10",
    "color-focus": "var(--color-accent)",
    "color-success": "#10b981",
    "color-warning": "#f59e0b",
    "color-error": "#ef4444"
  },
  "component": {
    "button": {
      "bg": "var(--color-primary)",
      "bg-hover": "var(--color-primary-hover)",
      "bg-active": "var(--color-primary-active)",
      "text": "var(--color-paper)",
      "text-hover": "var(--color-ink)",
      "border": "none",
      "border-radius": "0.5rem",
      "padding-horizontal": "var(--spacing-4)",
      "padding-vertical": "var(--spacing-3)",
      "font-family": "var(--font-display)",
      "font-weight": "600",
      "font-size": "0.875rem",
      "transition": "background-color 0.2s ease"
    },
    "button-disabled": {
      "bg": "var(--color-muted)",
      "cursor": "not-allowed",
      "opacity": "0.5"
    },
    "card": {
      "bg": "var(--color-card)",
      "border": "1px solid var(--color-card-border)",
      "border-radius": "0.75rem",
      "padding": "var(--spacing-6)",
      "shadow": "var(--shadow-sm)",
      "transition": "box-shadow 0.2s ease, transform 0.1s ease"
    },
    "card-hover": {
      "transform": "translateY(-2px)",
      "box-shadow": "var(--shadow-md)"
    },
    "input": {
      "border": "1px solid var(--color-border-subtle)",
      "border-radius": "0.375rem",
      "padding": "var(--spacing-3)",
      "font-family": "var(--font-body)",
      "transition": "border-color 0.2s ease"
    },
    "input-focus": {
      "border-color": "var(--color-primary)",
      "outline": "2px solid var(--color-primary)",
      "outline-offset": "2px"
    },
    "avatar": {
      "border": "2px solid var(--color-paper)",
      "border-radius": "full"
    }
  },
  "typography": {
    "base-font-size": "16px",
    "base-line-height": "1.5",
    "heading-font-family": "var(--font-display)",
    "body-font-family": "var(--font-body)",
    "heading-line-height": "1.1",
    "caption-line-height": "1.3",
    "font-sizes": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem"
    },
    "line-heights": {
      "tight": "1.1",
      "base": "1.5",
      "relaxed": "1.3",
      "heading": "1.1"
    }
  },
  "spacing": {
    "0": "0",
    "1": "0.25rem",
    "1.5": "0.375rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "20": "5rem",
    "24": "6rem"
  },
  "breakpoints": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  }
}